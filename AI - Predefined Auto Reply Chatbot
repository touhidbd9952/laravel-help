6. Main Chat Controller
php artisan make:controller ChatController
namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Str;
use App\Models\ChatSession;
use App\Models\ChatMessage;
use App\Services\ChatbotService;
use App\Services\AiChatService;

class ChatController extends Controller
{
    public function sendMessage(
        Request $request,
        ChatbotService $chatbotService,
        AiChatService $aiChatService
    ) {
        $request->validate([
            'message' => 'required|string|max:1000'
        ]);

        /*
        |--------------------------------------------------------------------------
        | Create or Find Chat Session
        |--------------------------------------------------------------------------
        */

        $token = session('chat_session_token');

        if (!$token) {

            $token = Str::uuid()->toString();

            session([
                'chat_session_token' => $token
            ]);
        }

        $chatSession = ChatSession::firstOrCreate(
            [
                'session_token' => $token
            ]
        );

        /*
        |--------------------------------------------------------------------------
        | Save Visitor Message
        |--------------------------------------------------------------------------
        */

        ChatMessage::create([
            'chat_session_id' => $chatSession->id,
            'message' => $request->message,
            'sender' => 'visitor'
        ]);

        /*
        |--------------------------------------------------------------------------
        | 1. Check Predefined Reply
        |--------------------------------------------------------------------------
        */

        $predefined = $chatbotService
            ->getPredefinedReply($request->message);

        if ($predefined['found']) {

            $answer = $predefined['answer'];

            $replyType = 'predefined';

        } else {

            /*
            |--------------------------------------------------------------------------
            | 2. Ask AI
            |--------------------------------------------------------------------------
            */

            $answer = $aiChatService
                ->getReply($request->message);

            $replyType = 'ai';

            /*
            |--------------------------------------------------------------------------
            | AI Failed
            |--------------------------------------------------------------------------
            */

            if (!$answer) {

                $answer = "Thank you for your message. "
                    . "Our representative will contact you soon.";

                $replyType = 'manual';
            }
        }

        /*
        |--------------------------------------------------------------------------
        | Save Bot Reply
        |--------------------------------------------------------------------------
        */

        ChatMessage::create([
            'chat_session_id' => $chatSession->id,
            'message' => $answer,
            'sender' => 'bot',
            'reply_type' => $replyType
        ]);

        return response()->json([
            'success' => true,
            'message' => $answer,
            'reply_type' => $replyType
        ]);
    }
}

